{
  "name": "@notesapp/storage-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json",
    "test:unit": "node ../../tools/run-tests.mjs unit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@notesapp/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
