{
  "name": "notesapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "26.8.1",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "versions:check": "node tools/check-versions.mjs",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck && tsc -p tests/integration/tsconfig.json",
    "lint": "node tools/check-versions.mjs && oxlint --type-aware --deny-warnings && node tools/check-boundaries.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "pnpm --filter @notesapp/api-contract --filter @notesapp/api-client --filter @notesapp/core run build && node tools/run-tests.mjs unit",
    "test:integration": "pnpm run build && node tools/run-tests.mjs integration",
    "build": "tsc -p tsconfig.json && pnpm -r --if-present build",
    "contract:lint": "pnpm --filter @notesapp/sdk-codegen run contract:lint",
    "generate": "pnpm --filter @notesapp/sdk-codegen run generate",
    "generated:check": "pnpm --filter @notesapp/sdk-codegen run generated:check",
    "db:generate": "pnpm --filter @notesapp/storage-server run db:generate",
    "db:migrate": "node packages/storage-server/src/migrate.ts"
  },
  "devDependencies": {
    "@notesapp/api-client": "workspace:*",
    "@notesapp/api-contract": "workspace:*",
    "@notesapp/core": "workspace:*",
    "@notesapp/server": "workspace:*",
    "@notesapp/storage-server": "workspace:*",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "oxc-parser": "0.148.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
