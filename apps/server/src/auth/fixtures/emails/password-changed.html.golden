<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;table-layout:fixed">
<tr><td class="brand-row" style="padding:0 4px 16px"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="32" height="32" style="width:32px;height:32px"><img class="logo-light" src="cid:notebook-light@notesapp" alt="" width="32" height="32" style="display:block;border:0;width:32px;height:32px"><div class="logo-dark" style="display:none;mso-hide:all"><img src="cid:notebook-dark@notesapp" alt="" width="32" height="32" style="display:block;border:0;width:32px;height:32px"></div></td><td class="strong" style="padding-left:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:600;color:#191917">tidy notebook</td></tr></table></td></tr>
<tr><td class="card" bgcolor="#ffffff" style="padding:32px;background-color:#ffffff;border:1px solid #e6e4e0;border-radius:12px;overflow-wrap:anywhere;word-wrap:break-word">
<p class="label warning" style="margin:0 0 6px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;letter-spacing:.04em;text-transform:uppercase;font-weight:600;color:#c02b3a">Security notice</p>
<h1 class="strong" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:31px;font-weight:700;color:#191917">Your password was changed</h1>
<p class="text" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#37352f;">The password for your account on tidy notebook at notes.example.com was changed on 23 October 2026 at 14:05 UTC. All devices that were signed in have been signed out.</p><p class="text" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#37352f;">If you didn&#39;t make this change, reset your password now.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="button-table" style="margin:24px 0 0"><tr><td class="button-cell" align="center" style="background-color:#1a1917;border-radius:8px;mso-padding-alt:0"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://notes.example.com/forgot-password" style="height:48px;v-text-anchor:middle;width:215px" arcsize="17%" stroke="f" fillcolor="#1a1917"><w:anchorlock/><center style="font-family:Arial,sans-serif;font-size:16px;font-weight:bold;color:#ffffff">Reset your password</center></v:roundrect><![endif]--><!--[if !mso]><!--><a class="button-link" href="https://notes.example.com/forgot-password" style="display:inline-block;padding:12px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;mso-padding-alt:0">Reset your password</a><!--<![endif]--></td></tr></table>

<p class="muted" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#67655f;margin:20px 0 4px;">Button not working? Copy and paste this link into your browser:</p>
<p class="url" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#37352f;word-break:break-word;overflow-wrap:anywhere"><a class="link" href="https://notes.example.com/forgot-password" style="color:#1a63c4;text-decoration:underline">https://notes.example.com/forgot-password</a></p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 0;table-layout:fixed"><tr><td class="panel" bgcolor="#f0efec" style="padding:16px;border-radius:8px;background-color:#f0efec"><p class="muted" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#67655f;margin:0;">If you made this change, you can ignore this email.</p></td></tr></table>
</td></tr><tr><td class="foot" style="padding:20px 4px;overflow-wrap:anywhere;word-break:break-word">
<p class="muted" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#67655f">Sent by tidy notebook at notes.example.com because the password for your account was changed. This is an automated email, so replies aren&#39;t read. For help, contact your installation administrator.</p>
</td></tr></table><!--[if mso]></td></tr></table><![endif]-->
