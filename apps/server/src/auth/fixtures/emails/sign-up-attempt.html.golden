<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;table-layout:fixed">
<tr><td class="brand-row" style="padding:0 4px 16px"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="32" height="32" style="width:32px;height:32px"><img class="logo-light" src="cid:notebook-light@notesapp" alt="tidy notebook" width="32" height="32" style="display:block;border:0;width:32px;height:32px"><!--[if !mso]><!--><img class="logo-dark" src="cid:notebook-dark@notesapp" alt="tidy notebook" width="32" height="32" style="display:none;border:0;width:32px;height:32px;mso-hide:all"><!--<![endif]--></td><td class="strong" style="padding-left:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:600;color:#191917">tidy notebook</td></tr></table></td></tr>
<tr><td class="card" bgcolor="#ffffff" style="padding:32px;background-color:#ffffff;border:1px solid #e6e4e0;border-radius:12px;overflow-wrap:anywhere;word-wrap:break-word">
<p class="label" style="margin:0 0 6px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;letter-spacing:.04em;text-transform:uppercase;font-weight:600;color:#67655f">Account notice</p>
<h1 class="strong" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:31px;font-weight:700;color:#191917">You already have an account</h1>
<p class="text" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#37352f;">Someone asked to create a new account on tidy notebook at notes.example.com with this email address. You already have an account, so nothing changed.</p><p class="text" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#37352f;">To sign in, open the sign-in page. If you don&#39;t know your password, select Forgot password.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="button-table" style="margin:24px 0 0"><tr><td class="button-cell" align="center" bgcolor="#1a1917" style="background-color:#1a1917;border-radius:8px;mso-padding-alt:0"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://notes.example.com/login" style="height:48px;v-text-anchor:middle;width:180px" arcsize="17%" stroke="f" fillcolor="#1a1917"><w:anchorlock/><center style="font-family:Arial,sans-serif;font-size:16px;font-weight:600;color:#ffffff">Sign in</center></v:roundrect><![endif]--><!--[if !mso]><!--><a class="button-link" href="https://notes.example.com/login" style="display:inline-block;padding:12px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;mso-padding-alt:0">Sign in</a><!--<![endif]--></td></tr></table>

<p class="muted" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#67655f;margin:20px 0 4px;">Button not working? Copy and paste this link into your browser:</p>
<p class="url" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#37352f;word-break:break-word;overflow-wrap:anywhere"><a class="link" href="https://notes.example.com/login" style="color:#1a63c4;text-decoration:underline">https://notes.example.com/login</a></p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 0;table-layout:fixed"><tr><td class="panel" bgcolor="#f0efec" style="padding:16px;border-radius:8px;background-color:#f0efec"><p class="muted" style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:25px;color:#67655f;margin:0;">If this wasn&#39;t you, you can ignore this email. Your account is safe.</p></td></tr></table>
</td></tr><tr><td class="foot" style="padding:20px 4px;overflow-wrap:anywhere;word-break:break-word">
<p class="muted" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#67655f">Sent by tidy notebook at notes.example.com because a sign-up used the email address of your existing account. This is an automated email, so replies aren&#39;t read. For help, contact your installation administrator.</p>
</td></tr></table><!--[if mso]></td></tr></table><![endif]-->
