{
  "name": "@notesapp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json && vite build && node ../../tools/precompress-assets.mjs dist/web",
    "test:unit": "node ../../tools/run-tests.mjs unit",
    "dev": "vite"
  },
  "dependencies": {
    "@notesapp/api-client": "workspace:*",
    "@notesapp/core": "workspace:*",
    "@notesapp/editor": "workspace:*",
    "@notesapp/markdown": "workspace:*",
    "@notesapp/logging": "workspace:*",
    "@notesapp/storage-browser": "workspace:*",
    "@notesapp/sync": "workspace:*",
    "@notesapp/ui": "workspace:*",
    "katex": "catalog:",
    "mermaid": "11.17.2",
    "react": "catalog:",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "type-fest": "4.41.0",
    "typescript": "catalog:toolchain",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1"
  }
}
