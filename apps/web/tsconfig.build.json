{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "lib": ["ES2024", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/pwa/precache.ts"],
  "references": [
    { "path": "../../packages/api-client/tsconfig.build.json" },
    { "path": "../../packages/core/tsconfig.build.json" },
    { "path": "../../packages/editor/tsconfig.build.json" },
    { "path": "../../packages/logging/tsconfig.build.json" },
    { "path": "../../packages/markdown/tsconfig.build.json" },
    { "path": "../../packages/storage-browser/tsconfig.build.json" },
    { "path": "../../packages/sync/tsconfig.build.json" },
    { "path": "../../packages/ui/tsconfig.build.json" }
  ]
}
